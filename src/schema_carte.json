{
    "title" : "schema armoire",
    "type" : "object",
    "required": [ "format", "version", "nom", "dimensions", "legende", "grille", "depart_robot", "armoire", "dictionnaire", "residents"],
    "properties": {
        "format": {
            "type": "string"
        },
        "version": {
            "type": "integer"
        },
        "nom": {
            "type": "string",
            "minLength": 1
        },
        "dimensions": {
            "type": "object",
            "required": ["hauteur", "largeur"],
            "properties": {
                "hauteur": {
                    "type":"integer",
                    "minimum": 3
                },
                "largeur": {
                    "type":"integer",
                    "minimum": 3
                }
            }
        },
        "legende": {
            "type": "object",
            "required": ["#",".","R","A","D","P"],
            "properties": {
                "#": {
                    "type":"string",
                    "minLength" : 1
                },
                ".": {
                    "type":"string",
                    "minLength" : 1
                },
                "R": {
                    "type":"string",
                    "minLength" : 1
                },
                "A": {
                    "type":"string",
                    "minLength" : 1
                },
                "D": {
                    "type":"string",
                    "minLength" : 1
                },
                "P": {
                    "type":"string",
                    "minLength" : 1
                }
            }
        },
        "grille": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "[#.RADP]+"
            },
            "minItems": 3
        },
        "depart_robot": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
                "type": "integer",
                "minimum": 0
            }
        },
        "armoire": {
            "type": "object",
            "required": ["position"],
            "properties": {
                "position": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                        "type": "integer",
                        "minimum": 0
                    }
                }
            }
        },
        "dictionnaire": {
            "type": "object",
            "required": ["position"],
            "properties": {
                "position": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                        "type": "integer",
                        "minimum": 0
                    }
                }
            }
        },
        "residents": {
            "type" : "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["id","nom","position"],
                "properties": {
                    "id": {
                        "type": "string",
                        "minLength" : 1
                    },
                    "nom": {
                        "type": "string",
                        "minLength" : 1
                    },
                    "position": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                            "type": "integer",
                            "minimum": 0
                        }
                    }
                }
            }
        }
    }
}